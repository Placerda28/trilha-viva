{
  "$schema": "node_modules/wrangler/config-schema.json",
  // O nome do Worker e a primeira etiqueta da URL:
  // <nome>.<subdominio-da-conta>.workers.dev. A conta "Trilha Viva" tem o
  // subdominio trilha-viva, entao chamar o Worker de "www" da
  // www.trilha-viva.workers.dev, que le como site e nao como projeto de teste.
  "name": "www",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // As variaveis (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, DRIVE_URL, etc.)
  // sao cadastradas no painel do Cloudflare, nao neste arquivo. Sem esta linha,
  // cada "wrangler deploy" apagaria todas elas e o site quebraria.
  "keep_vars": true
}
