# ---------------------------------------------------------------------------
# Trilha Viva — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel (produção).
# ---------------------------------------------------------------------------

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://trilha-viva.vercel.app

# --- Stripe -----------------------------------------------------------------
# Chave secreta da conta. Painel Stripe > Desenvolvedores > Chaves de API.
# Use sk_test_... para testar e sk_live_... quando for vender de verdade.
STRIPE_SECRET_KEY=

# Segredo do webhook. Painel Stripe > Desenvolvedores > Webhooks >
# adicione o endpoint https://SEU-SITE/api/webhook e copie o "signing secret".
# Eventos: checkout.session.completed e checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Alternativa sem chave secreta: cole aqui um Payment Link da Stripe.
# Só é usado quando STRIPE_SECRET_KEY estiver vazio.
NEXT_PUBLIC_PAYMENT_LINK=

# --- Entrega do acervo ------------------------------------------------------
# Link do Google Drive com as 4.000 VS. Fica SÓ no servidor: nunca é enviado
# ao navegador antes de o pagamento ser confirmado pela Stripe.
DRIVE_URL=

# --- E-mail (opcional, mas recomendado) -------------------------------------
# Conta gratuita em resend.com > API Keys.
RESEND_API_KEY=
EMAIL_FROM="Trilha Viva <acesso@seudominio.com>"

# --- Contato (opcional) -----------------------------------------------------
NEXT_PUBLIC_WHATSAPP=
