# ---------------------------------------------------------------------------
# Trilha Viva — variáveis do BUILD e do `npm run dev`
# Copie para .env.local (fica fora do git). Valores: painel da Cloudflare
# (Worker www) ou com o Paulo. Nunca coloque valor real neste arquivo.
# Lista conferida com o código em 19/10/2026.
# ---------------------------------------------------------------------------

# As NEXT_PUBLIC_* são gravadas no código NA HORA DO BUILD. Sem elas o login
# quebra ("A entrada ainda não está ativa"). Na Cloudflare ficam em
# Settings → Build → Variables and secrets.
NEXT_PUBLIC_SITE_URL=https://trilhaviva.org
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_WHATSAPP=
# Plano B da Stripe (só usado sem STRIPE_SECRET_KEY)
NEXT_PUBLIC_PAYMENT_LINK=

# As do servidor (segredos) ficam no Worker e no .dev.vars: veja .dev.vars.example.

# VS grátis: chave secreta do Turnstile (servidor; nunca NEXT_PUBLIC).
# Ausente: /api/vs-gratis responde 503 em produção; next dev dispensa a verificação.
TURNSTILE_SECRET_KEY=
